# ==============================================================================
# Hauntings of the Rift — Production & Deployment Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site Domain, Hosting & TLS Runtime Configuration
# ------------------------------------------------------------------------------
# Canonical HTTPS production domain for ticket links, callbacks, and redirects
SITE_URL=https://hauntingsoftherift.co.ke
VITE_APP_URL=https://hauntingsoftherift.co.ke
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Cryptographic Secrets
# ------------------------------------------------------------------------------
# 64-character hex secret for HMAC-SHA256 signature on QR passes
TICKET_HMAC_SECRET=
# Secret used to sign encrypted ticket recovery link tokens
RECOVERY_LINK_SECRET=
# Secret used to sign administrative session tokens
ADMIN_TOKEN_SECRET=

# ------------------------------------------------------------------------------
# 3. Safaricom Daraja M-Pesa API & Callback Reachability
# ------------------------------------------------------------------------------
# Live production callback URL reachable by Safaricom servers over public HTTPS
MPESA_CALLBACK_URL=https://hauntingsoftherift.co.ke/api/pay/callback
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=

# ------------------------------------------------------------------------------
# 4. Outbound Email Delivery (SMTP / Gmail App Password)
# ------------------------------------------------------------------------------
EMAIL_FROM=Verve & Co. <verve.n.co.ke@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=verve.n.co.ke@gmail.com
SMTP_PASS=

# ------------------------------------------------------------------------------
# 5. Database & Persistent Storage (Cloud SQL / PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string for relational database migrations (drizzle-kit push)
DATABASE_URL=
POSTGRES_URL=
SQL_HOST=
SQL_PORT=5432
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_SSL=true
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 6. Firebase & Firestore Configuration
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=verve-509008
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=verve-509008.firebaseapp.com
FIREBASE_FIRESTORE_DATABASE_ID=ai-studio-riftsembrace-48b92d68-fb99-42e2-b7e5-f301859f199f
FIREBASE_STORAGE_BUCKET=verve-509008.firebasestorage.app
FIREBASE_APP_ID=1:185758252762:web:6a0e2c3613d865f5b56fe3

VITE_FIREBASE_PROJECT_ID=verve-509008
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=verve-509008.firebaseapp.com
VITE_FIREBASE_FIRESTORE_DATABASE_ID=ai-studio-riftsembrace-48b92d68-fb99-42e2-b7e5-f301859f199f
VITE_FIREBASE_STORAGE_BUCKET=verve-509008.firebasestorage.app
VITE_FIREBASE_APP_ID=1:185758252762:web:6a0e2c3613d865f5b56fe3

# ------------------------------------------------------------------------------
# 7. WhatsApp Business API / Twilio Messaging (Optional Dispatch)
# ------------------------------------------------------------------------------
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_KEY=
TWILIO_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 8. Supabase (Alternative Mirror Storage)
# ------------------------------------------------------------------------------
SUPABASE_URL=
